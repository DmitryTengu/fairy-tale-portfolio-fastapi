# Скопируйте этот файл в .env и впишите свои данные. Файл .env не попадает в git.

# Почта художницы: сюда приходят сообщения из формы
CONTACT_EMAIL=angry.miu@gmail.com

# Почтовый сервер для отправки (пример для Gmail: нужен «пароль приложения», не обычный пароль)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=angry.miu@gmail.com
SMTP_PASSWORD=пароль-приложения

# От чьего имени идёт письмо (по умолчанию SMTP_USER)
# CONTACT_FROM=angry.miu@gmail.com
