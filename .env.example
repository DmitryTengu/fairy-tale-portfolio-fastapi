# Скопируйте этот файл в .env и впишите свои данные. Файл .env не попадает в git.

# Почта художницы: сюда приходят сообщения из формы
CONTACT_EMAIL=angry.miu@gmail.com

# Почтовый сервер для отправки (пример для Gmail: нужен «пароль приложения», не обычный пароль)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=angry.miu@gmail.com
SMTP_PASSWORD=пароль-приложения

# От чьего имени идёт письмо (по умолчанию SMTP_USER)
# CONTACT_FROM=angry.miu@gmail.com

# Игра со стикерами: сколько стикеров лежит на сайте одновременно (1-12). Следующая пятёрка появляется на следующий день
# STICKER_BATCH=5

# Адрес сайта: нужен для canonical, превью ссылок (Open Graph) и sitemap.xml
# SITE_URL=https://ваш-домен.by

# Прокси (Nginx и т.п.), которым верим в заголовке X-Forwarded-For: настоящий адрес посетителя для лимитов
# TRUSTED_PROXIES=127.0.0.1,::1

# Дополнительные сайты, с которых можно подключаться к общему холсту (через запятую)
# ALLOWED_ORIGINS=www.ваш-домен.by

# Адрес и порт для run.py (многие хостинги задают PORT сами)
# HOST=0.0.0.0
# PORT=8000

# Проверка на своём компьютере: 0 = не ждать следующего дня между пятёрками (на сайте в интернете оставьте 1)
# STICKER_DAY_GATE=1

